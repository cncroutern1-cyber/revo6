{
  "redirects": [{ "source": "/kuzatuv/", "destination": "/kuzatuv", "permanent": false }],
  "rewrites": [{ "source": "/kuzatuv", "destination": "/index.html" }],
  "headers": [
    { "source": "/sayt.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] }
  ]
}
